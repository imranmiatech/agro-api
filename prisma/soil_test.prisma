model SoilTestRequest {
  id              String    @id @default(uuid())
  requestNumber   String    @unique
  userId          String?
  farmerName      String
  phone           String
  email           String?
  district        String
  upazila         String
  villagePlot     String
  landArea        String
  targetCrop      String
  soilProblems    String?
  packageId       String    @default("pkg-standard")
  packageName     String    @default("Standard Laboratory Soil Test")
  amount          Float     @default(950)
  pickupMethod    String    @default("Courier Delivery")
  paymentMethod   String    @default("Stripe")
  paymentStatus   String    @default("Paid")
  transactionId   String?
  stripePaymentId String?
  status          String    @default("Pending Pickup")
  requestDate     DateTime  @default(now())
  completedDate   DateTime?
  labReport       Json?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("soil_test_requests")
}
