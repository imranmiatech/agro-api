model ConsultationTicket {
  id                          String                @id @default(uuid())
  ticketNumber                String                @unique
  userId                      String?
  farmerName                  String
  farmerEmail                 String?
  farmerPhone                 String?
  subject                     String
  category                    String                @default("Crop Disease")
  crop                        String?
  priority                    String                @default("Normal")
  status                      String                @default("Waiting for Reply")
  assignedExpertId            String?
  assignedExpertName          String?
  assignedExpertRole          String?
  assignedExpertAvatar        String?
  assignedExpertRating        Float?                @default(4.9)
  assignedExpertSpecialization String?
  ratingStars                 Int?
  ratingComment               String?
  ratedAt                     DateTime?
  messages                    ConsultationMessage[]
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt

  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@map("consultation_tickets")
}

model ConsultationMessage {
  id           String             @id @default(uuid())
  ticketId     String
  ticket       ConsultationTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender       String             // "user" | "expert"
  senderName   String
  senderRole   String?
  senderAvatar String?
  text         String             @db.Text
  attachments  String[]           @default([])
  createdAt    DateTime           @default(now())

  @@index([ticketId])
  @@index([createdAt])
  @@map("consultation_messages")
}
