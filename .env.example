# Application
NODE_ENV=production
PORT=3000

# PostgreSQL (used by docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=agro_db
POSTGRES_PORT=5433

# Local host CLI connection (Prisma Studio / local dev); inside Docker Compose, `api` connects to `postgres:5432`
DATABASE_URL="postgresql://postgres:change_me_strong_password@localhost:5433/agro_db?schema=public"

# JWT Authentication
JWT_SECRET=replace_with_a_long_random_jwt_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_jwt_refresh_secret

# Email / SMTP
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-smtp-app-password"
SMTP_FROM="Krisikunjo Marketplace <your-email@gmail.com>"

# Cloudinary Media Storage
CLOUD_NAME=your_cloud_name
CLOUD_API_KEY=your_cloud_api_key
CLOUD_API_SECRET=your_cloud_api_secret

# Stripe Billing
STRIPE_SECRET_KEY=sk_live_or_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Frontend & Admin Portal URLs
FRONTEND_URL=https://your-frontend-domain.com
CLIENT_URL=https://your-frontend-domain.com
ADMIN_URL=https://admin.your-frontend-domain.com
